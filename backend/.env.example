PORT=5000
JWT_SECRET=change_this_secret_key
JWT_EXPIRES_IN=7d

# Leave MONGO_URI empty to use the embedded pure-JS data store (zero setup, great for demo).
# Set it to use a real MongoDB / Atlas cluster instead.
MONGO_URI=

# Optional. OpenAI takes priority if both are set; otherwise falls back to Groq
# (OpenAI-compatible API, free tier, no card required); otherwise a deterministic
# rule-based generator is used instead (fully offline, no cost).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

CLIENT_URL=http://localhost:5000

ADMIN_SEED_EMAIL=admin@fitcoach.ai
ADMIN_SEED_PASSWORD=Admin@123
ADMIN_SEED_NAME=Super Admin
